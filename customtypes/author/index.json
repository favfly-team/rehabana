{
  "format": "page",
  "id": "author",
  "label": "Author",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "e.g. rehabana-team"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": ""
        }
      },
      "image": {
        "type": "Image",
        "config": {
          "label": "Image",
          "constraint": {
            "width": 800,
            "height": 800
          },
          "thumbnails": []
        }
      },
      "designation": {
        "type": "Text",
        "config": {
          "label": "Designation",
          "placeholder": ""
        }
      },
      "bio": {
        "type": "StructuredText",
        "config": {
          "label": "Bio",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "linkedin": {
        "type": "Link",
        "config": {
          "label": "LinkedIn",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": false,
          "repeat": false
        }
      },
      "twitter": {
        "type": "Link",
        "config": {
          "label": "Twitter",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": false,
          "repeat": false
        }
      }
    }
  }
}

